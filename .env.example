APP_NAME="Open Marine Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_CA

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database

# Local development logs mail instead of sending it.
# Configure your own SMTP provider only in the untracked runtime .env.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_ENCRYPTION=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="marine@example.test"
MAIL_FROM_NAME="${APP_NAME}"
MARINE_LOCAL_AUTO_VERIFY_EMAIL=true

MARINE_DEFAULT_REGION=ca-bc-west-coast
MARINE_LOCATION_TRACKING_DEFAULT=false
MARINE_LOCATION_RETENTION_DAYS=30
MARINE_LOCATION_RETENTION_MAX_DAYS=365
MARINE_EXPORT_EXPIRY_HOURS=72
MARINE_DOCUMENT_MAX_KB=20480
MARINE_MALWARE_SCANNER=disabled
MARINE_SUPPORT_EMAIL=

MARINE_MAP_PROVIDER=none
MARINE_MAP_ENABLED=false
MARINE_MAP_APPROVED=false
MARINE_OPEN_METEO_ENABLED=true
MARINE_ECCC_ENABLED=true
MARINE_ECCC_APPROVED=true
MARINE_CHS_ENABLED=true
MARINE_CHS_APPROVED=true
MARINE_CCG_ENABLED=false
MARINE_CCG_APPROVED=false
MARINE_NRCAN_ENABLED=false
MARINE_NRCAN_APPROVED=false
MARINE_USGS_EARTHQUAKES_ENABLED=true
MARINE_SOURCE_TIMEOUT_SECONDS=15
MARINE_SOURCE_RETRY_LIMIT=3
MARINE_SOURCE_STALE_MINUTES=60
MARINE_PUSH_ENABLED=false
MARINE_SMS_ENABLED=false
MARINE_MONITORING_DSN=

# Optional user-funded provider integrations. Never commit provider tokens.
MARINE_VESSELFINDER_ENABLED=true
MARINE_STORMGLASS_ENABLED=true
MARINE_WORLDTIDES_ENABLED=true
